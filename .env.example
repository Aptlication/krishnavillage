# ============================================================================
# KVNA api-server — environment template
# ============================================================================
# Copy this file to `.env` (or set the same variables in Railway / Replit
# secrets for deployed environments) and fill in real values.
#
# DO NOT COMMIT REAL VALUES. The Twilio Auth Token in particular is the
# equivalent of a password for your Twilio account — anyone with it can send
# SMS on your dime and access your message history. If a real token has ever
# been pasted into chat, a screenshot, a screenshare, or a commit, rotate it
# immediately in Twilio Console → Account → API keys & tokens.
# ============================================================================

# ----------------------------------------------------------------------------
# Twilio (SMS provider)
# ----------------------------------------------------------------------------

# Your Twilio Account SID. Visible in Twilio Console → Account Info. Starts
# with "AC". Not secret on its own, but pair with the Auth Token = full access.
TWILIO_ACCOUNT_SID=

# Your Twilio Auth Token. SECRET. Treat as a password. Rotate via the Twilio
# Console if it has ever leaked. Twilio supports a primary + secondary token
# so you can rotate without downtime.
TWILIO_AUTH_TOKEN=

# The sender shown to guests. Either a Twilio-provisioned phone number in
# E.164 format (e.g. +61491570006) or an alphanumeric sender ID Twilio has
# approved for your account (e.g. "KrishnaVlg"). Note: alphanumeric senders
# cannot receive replies — Twilio routes them to your account inbox instead.
TWILIO_FROM_NUMBER=

# Optional. The exact public URL Twilio is configured to POST status callbacks
# to, without trailing slash (e.g. https://api.krishnavillage.example.com).
# Set this when running behind a TLS-terminating proxy that may rewrite Host
# headers; the signature-verification middleware uses it to reconstruct the
# URL Twilio signed. Safe to leave blank locally.
TWILIO_WEBHOOK_BASE_URL=

# Optional. Set to "dryrun" to force log-only behaviour even when Twilio creds
# are present — useful for staging / load tests where you don't want real SMS
# to leave the building. Defaults to "twilio".
SMS_PROVIDER=twilio

# ----------------------------------------------------------------------------
# Tenant / regional defaults
# ----------------------------------------------------------------------------

# ISO 3166-1 alpha-2 country code used by the phone-number normaliser when a
# guest mobile is entered without an international prefix. Currently "AU" is
# the only special-cased region; other values fall back to requiring E.164
# format from reception. Defaults to "AU".
TENANT_DEFAULT_REGION=AU

# ----------------------------------------------------------------------------
# Auth (already required by the api-server — included here for completeness)
# ----------------------------------------------------------------------------

# Secret used to sign staff JWTs. Generate with `openssl rand -hex 32`. The
# api-server will refuse to start in production if this is unset.
JWT_SECRET=
